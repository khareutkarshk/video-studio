{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kids Animation Studio Project File",
  "description": "Canonical animation project envelope. Output format is separate from animation data.",
  "type": "object",
  "required": ["fileVersion", "settings", "scenes"],
  "properties": {
    "fileVersion": { "type": "integer", "const": 3 },
    "settings": {
      "type": "object",
      "required": ["name", "fps", "version"],
      "properties": {
        "name": { "type": "string" },
        "fps": { "type": "number", "minimum": 1 },
        "version": { "type": "integer" }
      }
    },
    "outputFormatId": {
      "type": "string",
      "description": "Preview/export preset id (youtube-landscape, youtube-shorts, instagram-reels)"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/scene" }
    }
  },
  "definitions": {
    "scene": {
      "type": "object",
      "required": ["id", "name", "duration", "layers"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "duration": { "type": "number", "minimum": 0.1 },
        "backgroundAssetId": { "type": ["string", "null"] },
        "transition": {
          "type": "object",
          "properties": {
            "type": { "enum": ["none", "fade", "crossfade"] },
            "duration": { "type": "number" }
          }
        },
        "camera": {
          "type": "object",
          "properties": {
            "keyframes": {
              "type": "array",
              "items": { "$ref": "#/definitions/cameraKeyframe" }
            }
          }
        },
        "audioTracks": {
          "type": "array",
          "items": { "$ref": "#/definitions/audioTrack" }
        },
        "reactionCues": {
          "type": "array",
          "items": { "$ref": "#/definitions/reactionCue" }
        },
        "layers": {
          "type": "array",
          "items": { "$ref": "#/definitions/layer" }
        }
      }
    },
    "layer": {
      "type": "object",
      "required": ["id", "assetId", "keyframes"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "assetId": { "type": "string" },
        "startTime": { "type": "number" },
        "endTime": { "type": "number" },
        "zIndex": { "type": "integer" },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "keyframes": {
          "type": "array",
          "items": { "$ref": "#/definitions/keyframe" }
        },
        "poseSegments": {
          "type": "array",
          "items": { "$ref": "#/definitions/poseSegment" }
        }
      }
    },
    "poseSegment": {
      "type": "object",
      "required": ["assetId", "startTime", "endTime"],
      "properties": {
        "assetId": { "type": "string" },
        "startTime": { "type": "number" },
        "endTime": { "type": "number" }
      }
    },
    "keyframe": {
      "type": "object",
      "required": ["time", "x", "y", "scale", "rotation", "opacity"],
      "properties": {
        "time": { "type": "number" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "scale": { "type": "number" },
        "rotation": { "type": "number" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "easing": { "enum": ["linear", "ease-in", "ease-out", "ease-in-out"] }
      }
    },
    "audioTrack": {
      "type": "object",
      "required": ["id", "name", "type", "startTime", "volume"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "enum": ["music", "ambience", "sfx", "dialogue"] },
        "assetId": { "type": "string" },
        "startTime": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "minimum": 0.01 },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "muted": { "type": "boolean" },
        "fadeIn": { "type": "number", "minimum": 0 },
        "fadeOut": { "type": "number", "minimum": 0 },
        "speaker": { "type": "string" },
        "text": { "type": "string" },
        "layerId": { "type": "string" }
      }
    },
    "reactionCue": {
      "type": "object",
      "required": ["id", "speaker", "startTime", "kind"],
      "properties": {
        "id": { "type": "string" },
        "speaker": { "type": "string" },
        "startTime": { "type": "number", "minimum": 0 },
        "endTime": { "type": "number", "minimum": 0 },
        "afterTrackId": { "type": "string" },
        "kind": { "enum": ["listen", "react"] }
      }
    },
    "cameraKeyframe": {
      "type": "object",
      "required": ["time", "x", "y", "zoom"],
      "properties": {
        "time": { "type": "number" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "zoom": { "type": "number" },
        "easing": { "enum": ["linear", "ease-in", "ease-out", "ease-in-out"] }
      }
    }
  }
}
